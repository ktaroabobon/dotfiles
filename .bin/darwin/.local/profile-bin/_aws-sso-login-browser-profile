#!/bin/sh
# aws sso login のログインページを、SSO の組織ごとに決めた Dia のプロファイルで開く。
#
# どの組織の SSO も、ブラウザに渡る URL は oidc.<region>.amazonaws.com などの同じ形で、
# ブラウザの Link Rules では組織を見分けられない。そこで --no-browser で URL を出させ、
# ログインする AWS プロファイルの SSO の入口(sso_start_url)から Dia のプロファイルを選び、
# AppleScript で開く。
#
# 対応表は ~/.config/aws-sso-login-browser-profile(組織の入口を含むので手元にだけ置く)。1 行に
# 「入口の URL に含まれる文字列」と「Dia のプロファイル名」を空白で区切って書く。
#   d-xxxxxxxxxx 仕事
# 対応が無いときは何もせず aws に任せ、Dia で開けないときは既定のブラウザで開く。
# _profile-wrapper から「本物の aws のパス」と引数を受け取る。
# macOS の /bin/sh(bash 3.2)は $( ) の中の case を誤って解釈するので、case は関数の中にだけ書く。

real=$1
shift
map_file=${AWS_SSO_LOGIN_BROWSER_PROFILE_MAP:-$HOME/.config/aws-sso-login-browser-profile}
aws_config=${AWS_CONFIG_FILE:-$HOME/.aws/config}

# <セクション名> <キー>: ~/.aws/config の値を 1 つ出す
config_value() {
  awk -v section="[$1]" -v key="$2" '
    /^[[:space:]]*\[/ {
      header = $0
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", header)
      in_section = (header == section)
      next
    }
    in_section {
      line = $0
      sub(/^[[:space:]]+/, "", line)
      if (index(line, key) != 1) next
      rest = substr(line, length(key) + 1)
      if (rest !~ /^[[:space:]]*=/) next
      sub(/^[[:space:]]*=[[:space:]]*/, "", rest)
      sub(/[[:space:]]+$/, "", rest)
      print rest
      exit
    }
  ' "$aws_config" 2>/dev/null
}

# <AWS プロファイル> <sso-session(指定があれば)>: ログインする SSO の入口の URL
start_url() {
  if [ -n "$2" ]; then
    config_value "sso-session $2" sso_start_url
    return
  fi
  if [ "$1" = default ]; then
    section=default
  else
    section="profile $1"
  fi
  session=$(config_value "$section" sso_session)
  if [ -n "$session" ]; then
    config_value "sso-session $session" sso_start_url
  else
    config_value "$section" sso_start_url
  fi
}

# <入口の URL>: 対応表で決まる Dia のプロファイル名
dia_profile_for() {
  [ -n "$1" ] && [ -f "$map_file" ] || return 0
  while read -r pattern name; do
    case $pattern in
      '' | '#'*) continue ;;
    esac
    case $1 in
      *"$pattern"*)
        printf '%s\n' "$name"
        return 0
        ;;
    esac
  done < "$map_file"
}

# <Dia のプロファイル名> <URL>: どのウィンドウのプロファイルでもよいので、名前の合うものに開く
open_in_dia() {
  command -v osascript > /dev/null 2>&1 || return 1
  osascript - "$1" "$2" > /dev/null 2>&1 <<'APPLESCRIPT'
on run argv
	set profileName to item 1 of argv
	set theURL to item 2 of argv
	tell application "Dia"
		activate
		repeat with w in windows
			try
				set p to first profile of w whose name is profileName
				set t to make new tab at end of tabs of p with properties {URL:theURL}
				focus t
				return
			end try
		end repeat
	end tell
	error "no Dia profile named " & profileName
end run
APPLESCRIPT
}

open_url() {
  if open_in_dia "$dia_profile" "$1"; then
    echo "(Dia の「$dia_profile」で開きました)"
  else
    echo "(Dia の「$dia_profile」で開けなかったため、既定のブラウザで開きます)"
    open "$1"
  fi
}

is_device_url() {
  case $1 in
    https://device.sso.*) return 0 ;;
  esac
  return 1
}

is_user_code() {
  case $1 in
    [A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9]-[A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9]) return 0 ;;
  esac
  return 1
}

profile=${AWS_PROFILE:-default}
sso_session=
is_sso_login=false
no_browser=false
prev=
for arg in "$@"; do
  case $prev in
    --profile) profile=$arg ;;
    --sso-session) sso_session=$arg ;;
  esac
  case $arg in
    --profile=*) profile=${arg#--profile=} ;;
    --sso-session=*) sso_session=${arg#--sso-session=} ;;
    --no-browser) no_browser=true ;;
    login) [ "$prev" = sso ] && is_sso_login=true ;;
  esac
  prev=$arg
done

if ! $is_sso_login || $no_browser; then
  exec "$real" "$@"
fi
dia_profile=$(dia_profile_for "$(start_url "$profile" "$sso_session")")
if [ -z "$dia_profile" ]; then
  exec "$real" "$@"
fi

# aws の終了コードはパイプの先に渡らないので、ファイルで受け取る
status_file=$(mktemp) || exec "$real" "$@"
{
  "$real" "$@" --no-browser 2>&1
  echo $? > "$status_file"
} | {
  opened=false
  device_url=
  while IFS= read -r line; do
    printf '%s\n' "$line"
    $opened && continue
    trimmed=$(printf '%s' "$line" | tr -d '[:space:]')
    if [ -n "$device_url" ] && is_user_code "$trimmed"; then
      # デバイスコードの方式は URL とコードが別の行に出るので、コード入りの URL にして開く
      open_url "${device_url%/}/?user_code=$trimmed"
      opened=true
      continue
    fi
    url=$(printf '%s\n' "$line" | grep -oE 'https://[^[:space:]]+' | head -n 1)
    [ -n "$url" ] || continue
    if is_device_url "$url" && ! is_user_code "${url##*user_code=}"; then
      device_url=$url
      continue
    fi
    open_url "$url"
    opened=true
  done
}
status=$(cat "$status_file")
rm -f "$status_file"
exit "${status:-1}"
