<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Brewfile の反映漏れを週次でチェックし、あれば draft PR を作る。

  このファイルはテンプレート。__REPO_ROOT__ / __HOME__ を実際のパスに置換して
  ~/Library/LaunchAgents/ へ書き出す (make brew-drift-install)。
  リポジトリの置き場所は環境によって違うため、直接リンクはしていない。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ktaroabobon.brew-drift</string>

  <!--
    ログインシェル (-l) 経由で呼ぶ。launchd の PATH は最小限で、
    そのままでは brew も gh も見つからないため .zprofile を読ませる。
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>__REPO_ROOT__/.bin/darwin/brew_drift.sh --pr</string>
  </array>

  <!--
    毎週月曜 10:00。指定時刻に Mac がスリープ/電源オフだった場合は、
    次に起動したタイミングで実行される (launchd の挙動)。
  -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>10</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <!-- 登録した瞬間に走らせない（意図しない PR を防ぐ） -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/brew-drift.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/brew-drift.log</string>
</dict>
</plist>
